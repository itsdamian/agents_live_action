# Agent Factory Platform — environment variables template
#
# Copy this file to `.env` and fill in the API key for the LLM provider you
# want to use:
#
#     cp .env.example .env
#
# If NO key is set, the system automatically runs in Mock mode: the pipeline
# still works end-to-end and all agent output is tagged with [MOCK MODE].

# Anthropic Claude: the only real provider that works today. Pick the model in
# the HUD (header model menu = project default; per agent in the add-agent form),
# e.g. claude-opus-5-5, or cheaper claude-sonnet-5-5 / claude-haiku-5-5. Agent
# YAML `llm_model` only applies in file mode. Leave empty to stay in Mock mode.
# Real calls cost money: also set PROJECT_BUDGET_USD below.
ANTHROPIC_API_KEY=

# OpenAI / Google Gemini: placeholders only, not implemented yet (a key here
# does not enable them).
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Cost control (optional) -------------------------------------------------
# Spend ceilings in USD. When a ceiling is crossed the pipeline stops enqueueing
# new tasks and broadcasts a critical devops:alert. Leave empty (or set to 0)
# to disable a guard.
#
# Maximum estimated spend across all projects for a single day.
DAILY_BUDGET_USD=

# Maximum estimated spend for any single project.
PROJECT_BUDGET_USD=

# --- Pipeline engine (optional) ----------------------------------------------
# `langgraph` (default) runs the pipeline as a LangGraph graph; `legacy` is the
# original loop. Uncomment to switch back to legacy.
# PIPELINE_ENGINE=legacy

# --- Docker Compose (optional) -----------------------------------------------
# Never call a real LLM, even when a key above is set (use this for demos and tests).
# FORCE_MOCK=true
#
# Host ports and bind address. Everything binds to loopback by default.
# FRONTEND_HOST_PORT=8080
# POSTGRES_HOST_PORT=5433
# BACKEND_HOST_PORT=8001      # only used with compose.expose-backend.yml
# HUD_BIND_ADDR=127.0.0.1
#
# Local-development database credentials (defaults: factory / factory / factory).
# POSTGRES_USER=factory
# POSTGRES_PASSWORD=factory
# POSTGRES_DB=factory
